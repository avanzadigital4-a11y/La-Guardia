; Engine configuration file.
; La Guardia — terror psicologico, Godot 4, renderizador Compatibility.

config_version=5

[application]

config/name="La Guardia"
config/description="Terror psicologico en una estacion antartica a punto de cerrar."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Settings="*res://scripts/autoload/settings.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
Subtitles="*res://scripts/ui/subtitles.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

